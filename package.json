{
  "name": "book-trip-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5174",
    "test": "tsx --test src/lib/*.test.ts",
    "test:e2e": "node tests/browser.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test:standalone": "node tests/standalone.mjs",
    "test:routes": "node tests/routes.mjs && node tests/routes.mjs --standalone",
    "test:mvp": "node tests/mvp-updates.mjs && node tests/mvp-updates.mjs --standalone",
    "typecheck": "tsc --noEmit",
    "test:integration": "node tests/integration-fixes.mjs && node tests/integration-fixes.mjs --standalone"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
